PORT=5000
TURSO_DATABASE_URL=https://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# UptimeRobot 24/7 Monitoring API
UPTIMEROBOT_API_KEY=your_uptimerobot_api_key
UPTIMEROBOT_MONITOR_ID=your_monitor_id

# Rate Limiting Thresholds (Configurable)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=2
RATE_LIMIT_AUTH_MAX_BACKOFF_SEC=300
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=180
